<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="4" author="ylab">

        <!-- Prepopulate one user -->
        <insert schemaName="domain" tableName="users">
            <column name="id" valueSequenceNext="users_seq"/>
            <column name="username" value="test_user"/>
            <column name="password" value="1234"/>
            <column name="role" value="USER"/>
        </insert>

        <!-- Prepopulate one product -->
        <insert schemaName="domain" tableName="product">
            <column name="id" valueSequenceNext="product_seq"/>
            <column name="name" value="Sample Product"/>
            <column name="category" value="General"/>
            <column name="brand" value="BrandX"/>
            <column name="price" value="99.99"/>
            <column name="description" value="Example product from migration"/>
        </insert>

    </changeSet>

</databaseChangeLog>
